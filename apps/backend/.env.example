NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/nodara?sslmode=require"

JWT_SECRET="replace-with-a-random-64-char-secret-never-commit-the-real-value"
JWT_EXPIRES_IN="7d"
SIWE_DOMAIN="localhost:3000"

# KeeperHub — the ONLY execution layer. Every transaction flows through this.
KEEPERHUB_API_URL="https://api.keeperhub.xyz"
KEEPERHUB_API_KEY="replace-with-your-keeperhub-api-key"

# Read-only RPCs used only by the monitoring engine
RPC_URL_MAINNET="https://eth-mainnet.g.alchemy.com/v2/replace-me"
RPC_URL_SEPOLIA="https://eth-sepolia.g.alchemy.com/v2/replace-me"
RPC_URL_BASE="https://base-mainnet.g.alchemy.com/v2/replace-me"
RPC_URL_BASE_SEPOLIA="https://base-sepolia.g.alchemy.com/v2/replace-me"

MONITOR_INTERVAL_MS=30000
MONITOR_ENABLED=true

FRONTEND_ORIGIN="http://localhost:3000"

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

LOG_LEVEL=info
