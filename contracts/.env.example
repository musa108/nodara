# BOT Chain Mainnet RPC — same value as the backend's RPC_URL_BOTCHAIN
RPC_URL_BOTCHAIN="https://rpc.botchain.ai"

# Deployer private key — DO NOT commit this file with a real value.
# Set this only in your local shell session (or a local, gitignored
# .env you source yourself), never paste it into chat, a commit, or
# any file that gets pushed to the repo.
DEPLOYER_PRIVATE_KEY="0xreplace-me-never-commit-a-real-key"

# Optional — only needed if BOTScan's Blockscout instance requires a
# key for verification (many Blockscout deployments don't). Leave
# unset and omit --etherscan-api-key from the verify command if so.
BOTSCAN_API_KEY=""
